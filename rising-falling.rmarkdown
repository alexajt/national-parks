<h4 style="margin:0 0 12px 0; font-size:1.1rem; color:#1E382B; font-family:Georgia,serif;">Top 10 Attendance Decreases</h4>
<div class="table-responsive">
<table class="table table-sm table-borderless mb-0" style="font-size:0.86rem; color:#223028;">
  <thead>
    <tr style="border-bottom:1.5px solid #DFDBD0; color:#4A5B51;">
      <th>Park Unit</th>
      <th class="text-end">2019</th>
      <th class="text-end">2025</th>
      <th class="text-end">Change</th>
    </tr>
  </thead>
  <tbody>
    `r HTML(falling_rows)`
