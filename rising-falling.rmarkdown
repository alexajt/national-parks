---
title: "Rising and Falling Parks"
subtitle: "How much did individual National Park Service units change from 2019 to 2025?"
execute:
  echo: false
  warning: false
  message: false
toc: false
---

```{r}
#| label: setup-change
library(tidyverse)
library(htmltools)

annual_visits <- read_csv(
  "nps_annual_visits_1979_2025.csv",
  show_col_types = FALSE
) |>
  filter(year %in% c(2019, 2025)) |>
  pivot_wider(
    names_from = year,
    values_from = recreation_visits,
    names_prefix = "year_"
  ) |>
  filter(!is.na(year_2019), !is.na(year_2025)) |>
  mutate(
    absolute_change = year_2025 - year_2019,
    percent_change = 100 * absolute_change / year_2019
  )

rising <- annual_visits |>
  slice_max(absolute_change, n = 10, with_ties = FALSE) |>
  mutate(change_group = "Largest absolute increases")

falling <- annual_visits |>
  slice_min(absolute_change, n = 10, with_ties = FALSE) |>
  mutate(change_group = "Largest absolute decreases")

change_sample <- bind_rows(
  rising |> mutate(group = "Largest increases (+)"),
  falling |> mutate(group = "Largest decreases (-)")
) |>
  mutate(
    park = forcats::fct_reorder(park, absolute_change),
    label_text = ifelse(
      absolute_change > 0,
      paste0("+", scales::label_comma(scale_cut = scales::cut_short_scale())(absolute_change)),
      scales::label_comma(scale_cut = scales::cut_short_scale())(absolute_change)
    ),
    label_hjust = ifelse(absolute_change > 0, -0.15, 1.15)
  )

rising_rows <- rising |>
  arrange(desc(absolute_change)) |>
  mutate(
    row_html = sprintf(
      "<tr><td class='fw-semibold'>%s</td><td class='text-end'>%s</td><td class='text-end'>%s</td><td class='text-end'><span style='display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.8rem;font-weight:600;background:#E2EAE3;color:#1E382B;'>+%s (+%.1f%%)</span></td></tr>",
      park, scales::comma(year_2019), scales::comma(year_2025), scales::comma(absolute_change), percent_change
    )
  ) |>
  pull(row_html) |>
  paste(collapse = "\n")

falling_rows <- falling |>
  arrange(absolute_change) |>
  mutate(
    row_html = sprintf(
      "<tr><td class='fw-semibold'>%s</td><td class='text-end'>%s</td><td class='text-end'>%s</td><td class='text-end'><span style='display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.8rem;font-weight:600;background:#FBEAE5;color:#8F3820;'>%s (%.1f%%)</span></td></tr>",
      park, scales::comma(year_2019), scales::comma(year_2025), scales::comma(absolute_change), percent_change
    )
  ) |>
  pull(row_html) |>
  paste(collapse = "\n")
```

## 2019 to 2025: The Biggest Shifts

Each bar shows the net difference in calendar-year attendance between **2019** and **2025**. Forest green bars extend right for the 10 largest visitation gains, while terracotta bars extend left for the 10 largest declines.

```{r}
#| label: fig-rising-falling
#| fig-cap: "Top 10 absolute increases and decreases in annual recreation visits between 2019 and 2025 among parks reporting in both years."
#| fig-width: 11
#| fig-height: 8.2

ggplot(change_sample, aes(x = absolute_change, y = park, fill = group)) +
  geom_col(width = 0.72) +
  geom_vline(xintercept = 0, color = "#1E382B", linewidth = 0.9) +
  geom_text(
    aes(label = label_text, hjust = label_hjust),
    size = 3.6,
    fontface = "bold",
    color = "#1E382B"
  ) +
  scale_fill_manual(
    values = c(
      "Largest increases (+)" = "#2F6B48",
      "Largest decreases (-)" = "#B06242"
    )
  ) +
  scale_x_continuous(
    labels = scales::label_comma(scale_cut = scales::cut_short_scale()),
    limits = c(-3350000, 2750000),
    expand = expansion(mult = c(0.04, 0.08))
  ) +
  labs(
    x = "Net change in annual recreation visits (2019 to 2025)",
    y = NULL,
    fill = NULL,
    caption = "Source: NPS Visitor Use Statistics. Units reporting in both 2019 and 2025."
  ) +
  theme_minimal(base_size = 12.5) +
  theme(
    plot.background = element_rect(fill = "#FAF7F0", color = NA),
    panel.background = element_rect(fill = "#FAF7F0", color = NA),
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_line(color = "#E6E1D2", linewidth = 0.5),
    legend.position = "top",
    legend.justification = "left",
    legend.text = element_text(size = 11, face = "bold", color = "#1E382B"),
    axis.text.y = element_text(size = 10, face = "bold", color = "#1E382B"),
    axis.text.x = element_text(color = "#4A5B51", size = 10.5)
  )
```

## Detailed Breakdown: Top 10 Gainers & Decliners

Bars show absolute changes; the tables also give percent changes. Only units with reports in both 2019 and 2025 are included. These comparisons show what changed, not why.

::: {.row .g-4 .mt-2}
::: {.col-lg-6}
::: {.card style="background-color:#FAF7F0; border:1px solid #D5D2C4; border-top:4px solid #2F6B48; border-radius:12px; padding:18px 20px; box-shadow:0 3px 12px rgba(30,56,43,0.04);"}
<h4 style="margin:0 0 12px 0; font-size:1.1rem; color:#1E382B; font-family:Georgia,serif;">Top 10 Attendance Increases</h4>
<div class="table-responsive">
<table class="table table-sm table-borderless mb-0" style="font-size:0.86rem; color:#223028;">
  <thead>
    <tr style="border-bottom:1.5px solid #DFDBD0; color:#4A5B51;">
      <th>Park Unit</th>
      <th class="text-end">2019</th>
      <th class="text-end">2025</th>
      <th class="text-end">Change</th>
    </tr>
  </thead>
  <tbody>
    `r HTML(rising_rows)`
  </tbody>
</table>
</div>
:::
